---
import { site } from "../config";

interface Props {
  /** Show the brand name next to the mark. */
  showName?: boolean;
  /** Override the displayed name (defaults to site.name from config.ts). */
  name?: string;
  /** Link target. Pass `false` to render with no link at all (e.g. on a
      single-page funnel that shouldn't navigate away). Defaults to "/". */
  href?: string | false;
}

const { showName = true, name, href = "/" } = Astro.props;
const displayName = name ?? site.name;
---

{
  href === false ? (
    <span class="flex items-center gap-2" aria-label={displayName}>
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-500 text-white">
        <svg
          class="h-[18px] w-[18px]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 19V6" />
          <path d="m6 12 6-6 6 6" />
        </svg>
      </span>
      {showName && (
        <span class="text-base font-bold tracking-tight text-ink">{displayName}</span>
      )}
    </span>
  ) : (
    <a href={href} class="flex items-center gap-2" aria-label={displayName}>
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-500 text-white">
        <svg
          class="h-[18px] w-[18px]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 19V6" />
          <path d="m6 12 6-6 6 6" />
        </svg>
      </span>
      {showName && (
        <span class="text-base font-bold tracking-tight text-ink">{displayName}</span>
      )}
    </a>
  )
}
