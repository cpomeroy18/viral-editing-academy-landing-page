---
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import SiteFooter from "../components/SiteFooter.astro";

// ============================================================
// REAL 404 PAGE.
//
// Without this file, Cloudflare Pages has no 404.html to serve for an
// unmatched path, so it falls back to the root index.html with a 200.
// Since index.html is now a meta-refresh/JS redirect to /offer (see that
// file's comment), every genuinely missing path - including /privacy and
// /terms before this commit - was silently landing on /offer instead of
// 404ing. This page gives Cloudflare a real 404.html to serve instead.
// ============================================================
const pageTitle = "Page Not Found";
---

<Base title={pageTitle} description="This page doesn't exist.">
  <header class="sticky top-0 z-40 border-b border-line bg-surface/90 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center px-6 py-4">
      <Logo href="/offer" />
    </div>
  </header>

  <main class="mx-auto flex min-h-[70dvh] max-w-xl flex-col items-center justify-center px-6 py-20 text-center">
    <h1 class="text-4xl font-extrabold tracking-tight text-ink md:text-5xl">Page not found</h1>
    <p class="mt-4 text-lg leading-relaxed text-ink-muted">
      The page you're looking for doesn't exist or has moved.
    </p>
    <a
      href="/offer"
      class="mt-8 inline-flex items-center justify-center rounded-lg bg-brand-500 px-6 py-3 text-sm font-semibold text-brand-ink transition-colors hover:opacity-90"
    >
      Back to the offer
    </a>
  </main>

  <SiteFooter logoHref={false} />
</Base>
