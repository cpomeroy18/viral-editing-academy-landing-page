---
import Base from "../layouts/Base.astro";
import CtaButton from "../components/CtaButton.astro";
import SiteNav from "../components/SiteNav.astro";
import Hero from "../components/Hero.astro";
import ProofStrip from "../components/ProofStrip.astro";
import StudentWins from "../components/StudentWins.astro";
import CheckoutCard from "../components/CheckoutCard.astro";
import Faq from "../components/Faq.astro";
import StickyCta from "../components/StickyCta.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ThemeCustomizer from "../components/ThemeCustomizer.astro";

// ============================================================
// ACADEMY PAGE (split-test variant of welcome.astro) - Viral Editing Academy
// Leads with Viral Editing Academy as the flagship offer; Viral VFX
// Vault is repositioned as a bonus. Rebuilt to mirror welcome.astro/
// offer.astro's full structure (trusted-by marquee, solution bridge,
// centerpiece showcase, media-rich "everything included") - see the
// per-section comments below for what's shared vs. local. Reuses
// benefits/who-it's-for/testimonials/core FAQ text from
// src/data/offer-content.ts (shared with welcome.astro and
// offer.astro) wherever the wording is generic enough to work for
// both products; anything that explicitly named "the Vault" as the
// primary product has a local, reworded override here instead - edit
// those in this file, everything else stays in sync with offer-content.ts.
// ============================================================
import {
  navLinks,
  heroHeadline,
  heroSecondaryLabel,
  heroTrustLabel,
  heroAvatars,
  heroVideo,
  trustedByLabel,
  trustedByLogos,
  problems,
  studentWins,
  forYou,
  notForYou,
  wins,
  about,
  ctaLabel,
  problemEyebrow,
  problemHeading,
  bridgeHeading,
  winsEyebrow,
  winsHeading,
  winsSub,
  includedEyebrow,
  includedHeading,
  benefitsEyebrow,
  benefitsHeading,
  whoEyebrow,
  whoHeading,
  forYouTitle,
  notForYouTitle,
  testimonialsEyebrow,
  testimonialsHeading,
  checkoutEyebrow,
  checkoutTotalValue,
  checkoutBadges,
  testimonialIncentive,
  aboutEyebrow,
  aboutHeading,
  faqEyebrow,
  faqHeading,
  finalCtaTrust,
  footerTagline,
  SECTION,
  HEADING,
} from "../data/offer-content";

// --- LOCAL: checkout link for this variant (Viral Editing Academy Stripe link) ---
const academyCheckoutUrl = "https://link.contentcreatormachine.com/payment-link/6a7e851d73c7ff66b05e8265";

// --- LOCAL: page title, hero eyebrow ---
const pageTitle = "Viral Editing Academy";
const heroEyebrow = "For content creators stuck under 10K followers";

// --- LOCAL: hero subheadline + bullets (Academy-specific framing).
// heroHeadline itself is now identical to the shared Vault headline, so
// it's imported directly above instead of duplicated here. ---
const heroSubheadline =
  "Unlock my complete Viral FX Editing System and start growing your following — with just your phone. No on-camera charisma or editing experience required.";
const heroBullets = [
  "Mobile-only editing, no expensive gear",
  "Learn the exact 5 tools behind nearly every viral effect you've seen",
  "Step-by-step tutorials that walk you from idea to posted video",
  "Includes the Viral VFX Vault free - 200+ effects, browsable anytime",
];

// --- LOCAL: stats block (Academy-specific numbers, not the Vault's). ---
const proofStats = [
  { value: "18+", label: "Step-by-step video tutorials" },
  { value: "$0", label: "Extra gear required" },
  { value: "Lifetime", label: "Access, no subscription" },
  { value: "Any Niche", label: "Works for any content style" },
  { value: "Included", label: "Full Vault access, free" },
];

// --- LOCAL: solution bridge subheadline (shared bridgeHeading text is
// reused unchanged above; bridgeSub explicitly names "the Vault" as the
// fix, so this page gets its own version naming the course instead). ---
const bridgeSub =
  "Every video you've posted probably had something worth watching. It just didn't stop the scroll. Viral Editing Academy fixes that - the exact system and effects that make people stop.";

// --- LOCAL: bonus stack, reordered - Academy is the flagship, Vault is
// "Bonus 1". Same 6 items and $772 total as the shared Vault-first stack
// (Bonus 5 corrected from $99 to $49 here too), just reordered/re-described
// and with media added to match welcome.astro/offer.astro's visual
// treatment. Media for bonuses 1-5 is reused directly from offer-content.ts
// (see comments per item); the flagship item intentionally has no
// thumbnail, same as before. Keep these four reused bonuses in sync by
// hand with offer-content.ts if they ever change there.
const deliverables = [
  {
    title: "Viral Editing Academy (Full Course)",
    value: "$299",
    // Same portrait 3-panel graphic (720x1350) used for this Bonus 1 item's
    // thumbnail on the Vault page - fixed-size box, object-contain, no
    // cropping. Desktop-only; mobile swaps to mobileVideo (course-scroll
    // screen-capture), same pattern as the Vault page. See offer-content.ts's
    // deliverables[1] for the source note on both clips.
    video: "/videos/included-bonus1-3phase.mp4",
    mobileVideo: "/videos/bonus1-course-scroll-mobile.mp4",
    portraitMedia: true,
    phases: [
      {
        title: "Phase 1 — Viral FX Foundations",
        desc: "Gear that works on any budget, phone settings that make your footage look intentional, and the lighting/composition basics that grab attention before you've made a single cut.",
      },
      {
        title: "Phase 2 — The 5 Foundational Editing Tools",
        desc: "Match cut, masking, keyframes, speed ramping, remove background - plus the quick-hit extras (transitions, zoom effects, camera angles) that separate a flat video from one that pops. Master these and you'll start spotting them in everything.",
      },
      {
        title: "Phase 3 — Full Effect Tutorials, Start to Finish",
        desc: "Idea, shot, edit, post - everything from Phases 1 and 2 combined into real, postable effects. 18 step-by-step walkthroughs you can follow immediately.",
      },
    ],
  },
  {
    title: "Bonus 1: Viral VFX Vault",
    desc: "The full library, searchable by difficulty, style, and use case, with a step-by-step tutorial behind every effect.",
    value: "$197",
    video: "/videos/included-vault-3.0.mp4",
    fit: "cover",
  },
  {
    title: "Bonus 2: Advanced Viral FX Course",
    desc: "15 additional next-level effects and techniques once you've got the basics down.",
    value: "$99",
    video: "/videos/benefit-stop-guessing.mp4",
    fit: "cover",
  },
  {
    title: "Bonus 3: Mobile Transitions Mini-Course",
    desc: "The transitions that make an edit feel seamless instead of choppy.",
    value: "$29",
    video: "/videos/included-bonus3-transitions.mp4",
    fit: "cover",
  },
  {
    title: "Bonus 4: CapCut Bootcamp",
    desc: "Every tool, shortcut, and setting worth knowing, so you're never fumbling mid-edit.",
    value: "$99",
    video: "/videos/benefit-save-hours-editing.mp4",
    fit: "cover",
  },
  {
    title: "Bonus 5: \"5 Ideas Into 30 Posts\" Workshop",
    desc: "Turn one idea into a month of content instead of one post and a blank page tomorrow.",
    value: "$49",
    image: "/images/bonus5-workshop.jpg",
  },
];
const checkoutDeliverables = deliverables.map((d) => ({ label: d.title, value: d.value }));
const checkoutTitle = "Enroll in Viral Editing Academy";
const checkoutOptions = [
  { label: "One-time payment", price: "$97", note: "Lifetime access, pay once", featured: true, href: academyCheckoutUrl },
];

// --- LOCAL: benefits, reworded only where the shared copy explicitly
// named "the Vault" as the thing doing the work (items 1 and 2) - the
// other four are generic enough to reuse verbatim. ---
const benefits = [
  { title: "Skyrocket your views and following", desc: "Every effect you'll learn is already proven - real videos that pulled real views. Steal what works instead of guessing.", video: "/videos/benefit-skyrocket-views.mp4", fit: "cover" },
  { title: "Never run out of content ideas again", desc: "Learn the system, pick an effect, shoot. No more staring at your phone wondering what to post next.", video: "/videos/included-vault-3.0.mp4", fit: "cover" },
  { title: "Edit like a pro with just your phone", desc: "No laptop, no expensive software, no gear list. Everything's built for CapCut on your phone - the same way I do it.", video: "/videos/benefit-edit-with-just-your-phone.mp4", fit: "cover" },
  { title: "Save hours of editing time", desc: "Every tutorial skips the trial and error. You get the exact steps, not an afternoon spent reverse-engineering someone else's edit.", video: "/videos/benefit-save-hours-editing.mp4", fit: "cover" },
  { title: "Stand out in the scroll", desc: "Most people are posting the same flat talking-head video. A few seconds of the right effect is what stops the thumb.", video: "/videos/benefit-stand-out-v2.mp4", fit: "cover" },
  { title: "Stop guessing. Start growing.", desc: "You don't need a content strategy degree. You need a system you can actually follow - this is that system.", video: "/videos/benefit-stop-guessing.mp4", fit: "cover" },
];

// --- LOCAL: about bio2 - shared version frames the Vault as primary and
// Academy as the free-included bonus, the opposite of this page's
// positioning, so it gets its own version here. bio/name/role/image are
// generic enough to reuse from the shared `about` object unchanged. ---
const aboutBio2 =
  "Viral Editing Academy is the exact system I use, taught step-by-step - from the foundations to the five core tools to full effect walkthroughs. It also comes with the Viral VFX Vault free, so once you've learned the system, you'll never run out of what to make next.";

// --- LOCAL: final CTA copy + sticky bar note. Shared finalCtaHeading is
// now identical to this page's hero headline too (both changed to the
// same "Turn your phone into..." text) - welcome.astro already avoids
// that duplication with its own local override, so this page needs the
// same treatment now for the same reason. ---
const finalCtaHeading = "Enroll and start creating scroll-stopping content";
const finalCtaSub =
  "Enroll in Viral Editing Academy and start creating edits that get attention, grow your following, and open doors - all with your phone.";
const stickyNote = "Viral Editing Academy";

// --- LOCAL: "How it works" - 5 real curriculum modules (replaces the
// shared 3-step Vault search/tutorial/apply section, which doesn't
// describe this offer). Text content left completely unchanged in the
// prior rebuild, per instruction - this content is accurate and specific
// to the course as-is. Module 2 reuses a clip already converted for
// welcome/offer's benefits grid (Masking Explained.gif); Module 3 and
// Module 4 use their own dedicated clips (Simple VFX Spice.gif, LP
// Tutorials.gif); Module 5 reuses the same Vault showcase clip used
// elsewhere on both pages (included-vault-3.0.mp4). ---
const modulesEyebrow = "The curriculum";
const modulesHeading = "Five modules, start to finish";
const modulesSub =
  "Not a random pile of tutorials - a straight line from knowing nothing to reverse-engineering any effect you see.";
const modules = [
  {
    title: "Module 1: Setup, Shooting & Editing Essentials",
    desc: "Before you touch an effect, you get the basics locked in - shot right, lit right, ready to edit.",
    highlights: [
      "Gear that works on any budget - what's worth buying and what you can skip",
      "The exact phone settings that make your footage look intentional, not accidental",
      "Lighting and composition basics that grab attention before you've made a single cut",
    ],
    video: "/videos/module-1-phone-settings.mp4",
    fit: "cover",
  },
  {
    title: "Module 2: The 5 Foundational Tools of Viral Edits",
    desc: "Almost every effect you've ever seen go viral comes down to the same five tools.",
    highlights: [
      "Match cut, masking, keyframes, speed ramping, and remove background",
      "Each one broken down step by step, at your own pace",
      "Learn these five once and you'll start spotting them in everything",
    ],
    video: "/videos/benefit-save-hours-editing.mp4",
    fit: "cover",
  },
  {
    title: "Module 3: Simple VFX Spice",
    desc: "The small, quick-hit techniques that separate a flat video from one that pops.",
    highlights: [
      "Transitions, zoom effects, and camera angles you can drop into any edit",
      "Nothing complicated - just the details most people skip",
    ],
    video: "/videos/module-3-simple-vfx-spice.mp4",
    fit: "cover",
  },
  {
    title: "Module 4: Viral Effect Tutorials",
    desc: "Now everything comes together - full walkthroughs, start to finish.",
    highlights: [
      "Every tutorial combines the tools from Modules 1-3 into one finished effect",
      "Idea, shot, edit, post - the whole path, every time",
    ],
    video: "/videos/module-4-lp-tutorials.mp4",
    fit: "cover",
  },
  {
    title: "Module 5: The Viral VFX Vault",
    desc: "You've learned the tools. This is where you keep finding what to make next - forever.",
    highlights: [
      "The same searchable library behind the free FX Mini-Vault, fully unlocked",
      "New effects added on an ongoing basis, browsable by difficulty, style, or use case",
    ],
    video: "/videos/included-vault-3.0.mp4",
    fit: "cover",
  },
];

// --- LOCAL: effects showcase - merges what used to be two separate
// sections (a single big "Take a look inside" Vault-scroll video, and a
// 5-clip "Real effects" grid) into one. Each clip here is itself a
// composite of 3 effects shown side by side (already 16:9 as a whole),
// converted from Gifs/ the same way as the other showcase/benefit videos. ---
const effectsShowcaseHeading = "Some of the effects you'll learn to create";
const effectsShowcaseSub = "A few examples of what you'll be making - step by step, on your phone.";
const effectsShowcaseClips = [
  { video: "/videos/showcase-teleport-shirtrip-jump.mp4", label: "Teleport · Shirt-Rip Transition · Building Jump" },
  { video: "/videos/showcase-clone-handflick-superhero.mp4", label: "Clone Walk By · Giant Hand Flick · Superhero Landing" },
  { video: "/videos/showcase-textbehind-pole-objectappear.mp4", label: "Text Behind Effect · Pole Transition · Object Appear" },
];

// --- LOCAL: FAQ. Two items from the shared base list explicitly framed
// the Vault as the primary product being described, so they're reworded
// here for Academy; the rest are reused verbatim. Plus one page-specific
// addition at the end (unchanged from before). ---
const academyFaqs = [
  { q: "What exactly is Viral Editing Academy?", a: "It's a step-by-step course that teaches you the exact mobile editing system and effects that actually go viral - the tools, the process, and full walkthroughs, done on your phone, so you're never guessing how something was made." },
  { q: "Do I need any editing experience?", a: "No. Every tutorial assumes you're starting from zero. If you can tap record on your phone, you can follow along." },
  { q: "Does every effect have its own dedicated tutorial?", a: "Effects are organized by the core tool used to create them - a small set of tools, each with a complete, dedicated tutorial. So instead of hundreds of one-off explainer videos, you get deep, proper breakdowns of the tools themselves, which apply across many effects. Some effects also include extra notes on top of the core tutorial." },
  { q: "Will this work for my niche?", a: "Yes. These are editing and effect skills, not niche-specific tricks. Doesn't matter if you're a creator, a coach, or a business owner posting your own content - the technique transfers." },
  { q: "Can't I just learn this for free on YouTube or TikTok?", a: "You can find pieces of it, sure. But free tutorials are usually rushed, skip steps, or leave out the one detail that actually makes the effect work. Everything here is organized and built to be followed start to finish - not pieced together from ten different videos." },
  { q: "What do I actually get inside?", a: "Viral Editing Academy itself, plus five bonuses - the Viral VFX Vault (200+ effects, browsable anytime), the Advanced Viral FX course, a mobile transitions mini-course, a CapCut bootcamp, and the \"5 Ideas Into 30 Posts\" workshop. Full breakdown above, with what each is worth on its own." },
  { q: "Can I really do this with just my phone?", a: "Yes - that's the whole point. No laptop, no expensive software, no gear list. Everything's built around CapCut, the same way I edit." },
  { q: "Is there a guarantee?", a: "Yes. Try it for 7 days. If it's not for you, email us and you'll get a full refund - no hoops to jump through." },
  { q: "What if I don't know my niche yet?", a: "You don't need one to start. These are editing and effect skills - they work no matter what you end up posting about. Most people figure out their niche by making content, not before." },
];

// --- POST-OPTIN CONFIRMATION BANNER (same pattern/copy as welcome.astro -
// the underlying lead magnet doesn't change between split-test variants). ---
const confirmationBanner =
  "You're in! Check your inbox — the FX Mini-Vault is on its way. While you're here...";
---

<Base title={pageTitle} description={heroSubheadline}>
  <div class="bg-brand-500 px-6 py-6 text-brand-ink md:py-8">
    <div class="mx-auto flex max-w-6xl items-center justify-center gap-3 text-center text-lg font-bold md:text-xl">
      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-ink/20">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4 10-12" />
        </svg>
      </span>
      <span>{confirmationBanner}</span>
    </div>
  </div>

  <SiteNav links={navLinks} ctaLabel={ctaLabel} ctaHref={academyCheckoutUrl} logoName={pageTitle} logoHref={false} />

  <Hero
    mode="split"
    eyebrow={heroEyebrow}
    headline={heroHeadline}
    subheadline={heroSubheadline}
    bullets={heroBullets}
    ctaLabel={ctaLabel}
    ctaHref={academyCheckoutUrl}
    secondaryLabel={heroSecondaryLabel}
    secondaryHref="#how"
    trustLabel={heroTrustLabel}
    avatars={heroAvatars}
    image="https://picsum.photos/seed/vea-hero/1100/900"
    mediaVideo={heroVideo}
  />

  <!-- TRUSTED BY (auto-scrolling logo marquee) - same component/logos as
       welcome.astro/offer.astro. bg-white / text-black are intentional,
       not tokens - see those files for why. -->
  <section class="bg-white py-10">
    <div class="mx-auto max-w-6xl px-6">
      <p class="text-center text-xs font-bold uppercase tracking-wide text-black/60">{trustedByLabel}</p>
      <div class="relative mt-6 overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]">
        <div class="flex w-max animate-marquee items-center gap-12">
          {
            [...trustedByLogos, ...trustedByLogos].map((logo) => (
              <img src={logo.src} alt={logo.alt} class="h-10 w-auto shrink-0 object-contain" loading="lazy" />
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <ProofStrip stats={proofStats} />

  <div data-sticky-sentinel></div>

  <!-- PROBLEM -->
  <section class="bg-surface-2">
    <div class={SECTION}>
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-sm font-bold uppercase tracking-wide text-brand-600">{problemEyebrow}</p>
        <h2 class={`mt-3 ${HEADING}`}>{problemHeading}</h2>
      </div>
      <ul class="mx-auto mt-10 grid max-w-3xl gap-4 sm:grid-cols-2">
        {
          problems.map((p) => (
            <li class="flex items-start gap-3 rounded-card border border-line bg-card p-5 text-ink">
              <span class="mt-0.5 text-lg leading-none text-brand-500">&#10005;</span>
              <span class="text-base leading-snug">{p}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- SOLUTION BRIDGE (short transition, no eyebrow) -->
  <section class="bg-surface">
    <div class="mx-auto max-w-2xl px-6 py-12 text-center md:py-16">
      <h2 class={HEADING}>{bridgeHeading}</h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-muted">{bridgeSub}</p>
    </div>
  </section>

  <!-- CURRICULUM / HOW IT WORKS (5 modules) - unchanged -->
  <section id="how" class="bg-surface">
    <div class={SECTION}>
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-sm font-bold uppercase tracking-wide text-brand-600">{modulesEyebrow}</p>
        <h2 class={`mt-3 ${HEADING}`}>{modulesHeading}</h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-muted">
          {modulesSub}
        </p>
      </div>
      <div class="mx-auto mt-12 max-w-4xl space-y-8">
        {
          modules.map((m) => (
            <div class="grid items-center gap-0 overflow-hidden rounded-card border border-line bg-card md:grid-cols-[2fr_3fr]">
              <video
                src={m.video}
                autoplay
                muted
                loop
                playsinline
                class={`aspect-video w-full ${
                  m.fit === "contain" ? "bg-surface-2 object-contain" : "object-cover"
                }`}
              />
              <div class="p-6">
                <h3 class="text-lg font-bold text-ink">{m.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-muted">{m.desc}</p>
                <ul class="mt-4 space-y-2">
                  {m.highlights.map((h) => (
                    <li class="flex items-start gap-2.5 text-sm text-ink">
                      <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-500">
                        <svg class="h-3 w-3 text-brand-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4 10-12" />
                        </svg>
                      </span>
                      <span class="leading-relaxed">{h}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- EFFECTS SHOWCASE (3 composite clips, each 3 effects side by side) -->
  <section class="bg-surface-2">
    <div class={SECTION}>
      <div class="mx-auto max-w-2xl text-center">
        <h2 class={HEADING}>{effectsShowcaseHeading}</h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-muted">{effectsShowcaseSub}</p>
      </div>
      <div class="mx-auto mt-10 max-w-4xl space-y-6 lg:grid lg:grid-cols-3 lg:gap-6 lg:space-y-0">
        {
          effectsShowcaseClips.map((c) => (
            <div class="overflow-hidden rounded-card border border-line bg-card shadow-xl shadow-black/5">
              <video
                src={c.video}
                autoplay
                muted
                loop
                playsinline
                class="aspect-video w-full object-cover"
              />
              <p class="px-4 py-3 text-sm font-medium text-ink-muted">{c.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- STUDENT WINS (rotating, result-led) -->
  <StudentWins
    eyebrow={winsEyebrow}
    heading={winsHeading}
    subheading={winsSub}
    wins={studentWins}
  />

  <!-- WHAT YOU GET -->
  <section id="included" class="bg-surface-2">
    <div class={SECTION}>
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-sm font-bold uppercase tracking-wide text-brand-600">{includedEyebrow}</p>
        <h2 class={`mt-3 ${HEADING}`}>{includedHeading}</h2>
      </div>
      <div class="mx-auto mt-12 max-w-4xl border-t border-line">
        {
          deliverables.map((d) => {
            // portraitMedia (Academy full-course item only): fixed 160px-wide,
            // aspect-[8/15] box, image fully contained (no crop) - same
            // treatment as this same asset's Bonus 1 thumbnail on the Vault page.
            const mediaBoxSizeClass = d.portraitMedia ? "w-[160px] aspect-[8/15]" : "";
            const mediaAspectClass = d.portraitMedia ? "" : "aspect-video";
            const mediaFitClass = d.portraitMedia
              ? "w-full h-full object-contain"
              : d.fit === "contain"
                ? "w-full object-contain"
                : "w-full object-cover";
            return (
              <div class="border-b border-line py-7">
                <div class={d.video || d.image ? "grid gap-5 sm:grid-cols-[160px_1fr] sm:items-start" : ""}>
                  {
                    (d.video || d.image) && (
                      d.mobileVideo ? (
                        <>
                          {/* Mobile: full-width 16:9 box matching this clip's native
                              aspect ratio (a landscape screen-capture, not the portrait
                              teleport-sequence graphic desktop uses) - object-cover so
                              there's no letterboxing even if it's off by a hair. */}
                          <div class="aspect-video w-full overflow-hidden rounded-card border border-line bg-surface-2 sm:hidden">
                            <video
                              src={d.mobileVideo}
                              autoplay
                              muted
                              loop
                              playsinline
                              class="h-full w-full object-cover"
                            />
                          </div>
                          <div class={`hidden overflow-hidden rounded-card border border-line bg-surface-2 sm:block ${mediaBoxSizeClass}`}>
                            <video
                              src={d.video}
                              autoplay
                              muted
                              loop
                              playsinline
                              class={`${mediaAspectClass} ${mediaFitClass}`}
                            />
                          </div>
                        </>
                      ) : (
                        <div class={`overflow-hidden rounded-card border border-line bg-surface-2 ${mediaBoxSizeClass}`}>
                          {d.video ? (
                            <video
                              src={d.video}
                              autoplay
                              muted
                              loop
                              playsinline
                              class={`${mediaAspectClass} ${mediaFitClass}`}
                            />
                          ) : (
                            <img
                              src={d.image}
                              alt=""
                              width="1200"
                              height="676"
                              class={`${mediaAspectClass} ${mediaFitClass}`}
                              loading="lazy"
                            />
                          )}
                        </div>
                      )
                    )
                  }
                  <div>
                    <div class="flex items-start justify-between gap-4">
                      <h3 class="text-xl font-bold text-ink md:text-2xl">{d.title}</h3>
                      <span class="mt-1 shrink-0 rounded-full border border-line px-3 py-1 text-[11px] font-medium uppercase tracking-wide text-ink-muted">
                        {d.value} value
                      </span>
                    </div>
                    {d.desc && <p class="mt-2 max-w-2xl text-base leading-relaxed text-ink-muted">{d.desc}</p>}
                    {
                      d.phases && (
                        <div class="mt-4 space-y-4">
                          {d.phases.map((p) => (
                            <div>
                              <p class="text-sm font-bold text-ink">{p.title}</p>
                              <p class="mt-1 max-w-2xl text-sm leading-relaxed text-ink-muted">{p.desc}</p>
                            </div>
                          ))}
                        </div>
                      )
                    }
                  </div>
                </div>
              </div>
            );
          })
        }
        </div>
      </div>
    </section>

  <!-- BENEFITS -->
  <section class="bg-surface">
    <div class={SECTION}>
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-sm font-bold uppercase tracking-wide text-brand-600">{benefitsEyebrow}</p>
        <h2 class={`mt-3 ${HEADING}`}>{benefitsHeading}</h2>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          benefits.map((b) => (
            <div class="overflow-hidden rounded-card border border-line bg-card">
              <video
                src={b.video}
                autoplay
                muted
                loop
                playsinline
                class={`aspect-video w-full ${
                  b.fit === "contain" ? "bg-surface-2 object-contain" : "object-cover"
                }`}
              />
              <div class="p-6">
                <span class="flex h-9 w-9 items-center justify-center rounded-full bg-brand-500">
                  <svg class="h-4 w-4 text-brand-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4 10-12" />
                  </svg>
                </span>
                <h3 class="mt-4 text-lg font-bold text-ink">{b.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-muted">{b.desc}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- WHO IT'S FOR -->
  <section class="bg-surface-2">
    <div class={SECTION}>
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-sm font-bold uppercase tracking-wide text-brand-600">{whoEyebrow}</p>
        <h2 class={`mt-3 ${HEADING}`}>{whoHeading}</h2>
      </div>
      <div class="mx-auto mt-12 grid max-w-4xl gap-6 md:grid-cols-2">
        <div class="rounded-card bg-surface-dark p-7 text-ink-dark md:p-8">
          <h3 class="text-xl font-bold">{forYouTitle}</h3>
          <ul class="mt-5 space-y-4">
            {
              forYou.map((item) => (
                <li class="flex items-start gap-3">
                  <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-500">
                    <svg class="h-3 w-3 text-brand-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4 10-12" />
                    </svg>
                  </span>
                  <span class="text-sm leading-relaxed">{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="rounded-card border border-line bg-card p-7 md:p-8">
          <h3 class="text-xl font-bold text-ink">{notForYouTitle}</h3>
          <ul class="mt-5 space-y-4">
            {
              notForYou.map((item) => (
                <li class="flex items-start gap-3">
                  <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-ink-muted/15 text-ink-muted">
                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true">
                      <path d="m6 6 12 12" />
                      <path d="m18 6-12 12" />
                    </svg>
                  </span>
                  <span class="text-sm leading-relaxed text-ink-muted">{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- PROOF / TESTIMONIALS GRID -->
  <section class="bg-surface-2">
    <div class={SECTION}>
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-sm font-bold uppercase tracking-wide text-brand-600">{testimonialsEyebrow}</p>
        <h2 class={`mt-3 ${HEADING}`}>{testimonialsHeading}</h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {
          wins.map((w) => (
            <div class="flex flex-col rounded-card border border-line bg-card p-6">
              <div class="flex text-sm leading-none tracking-wide text-brand-500" aria-hidden="true">
                &#9733;&#9733;&#9733;&#9733;&#9733;
              </div>
              <p class="mt-4 flex-1 text-base leading-relaxed text-ink">&#8220;{w.quote}&#8221;</p>
              <div class="mt-5 flex items-center gap-3 border-t border-line pt-4">
                <img
                  src={w.image}
                  alt={w.name}
                  width="40"
                  height="40"
                  class="h-10 w-10 shrink-0 rounded-full object-cover"
                  loading="lazy"
                />
                <div class="min-w-0 flex-1">
                  <p class="truncate text-sm font-semibold text-ink">{w.name}</p>
                  <p class="truncate text-xs text-ink-muted">{w.role}</p>
                </div>
                <span class="shrink-0 rounded-full bg-chip px-2.5 py-1 text-xs font-bold text-chip-ink">{w.result}</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CHECKOUT (one-time) -->
  <CheckoutCard
    eyebrow={checkoutEyebrow}
    title={checkoutTitle}
    deliverables={checkoutDeliverables}
    totalValue={checkoutTotalValue}
    options={checkoutOptions}
    badges={checkoutBadges}
  />

  <!-- TESTIMONIAL INCENTIVE (separate from the value stack above) -->
  <div class="mx-auto max-w-2xl px-6 pb-16 text-center md:pb-20">
    <p class="text-sm text-ink-muted">{testimonialIncentive}</p>
  </div>

  <!-- ABOUT -->
  <section class="bg-surface">
    <div class={SECTION}>
      <div class="grid items-center gap-10 md:grid-cols-[2fr_3fr] md:gap-14">
        <div class="overflow-hidden rounded-card border border-line bg-surface-2">
          <img src={about.image} alt={about.name} width="900" height="1352" class="aspect-[4/5] w-full object-cover" loading="lazy" />
        </div>
        <div>
          <p class="text-sm font-bold uppercase tracking-wide text-brand-600">{aboutEyebrow}</p>
          <h2 class={`mt-3 ${HEADING}`}>{aboutHeading}</h2>
          <p class="mt-2 text-base font-medium text-ink-muted">{about.role}</p>
          <p class="mt-5 text-lg leading-relaxed text-ink-muted">{about.bio}</p>
          <p class="mt-4 text-lg leading-relaxed text-ink-muted">{aboutBio2}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="bg-surface-2">
    <div class="mx-auto max-w-3xl px-6 py-16 md:py-20">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-sm font-bold uppercase tracking-wide text-brand-600">{faqEyebrow}</p>
        <h2 class={`mt-3 ${HEADING}`}>{faqHeading}</h2>
      </div>
      <div class="mt-10">
        <Faq items={academyFaqs} />
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="bg-surface-dark text-ink-dark">
    <div class="mx-auto max-w-3xl px-6 py-20 text-center md:py-24">
      <h2 class="text-3xl font-extrabold tracking-tight md:text-4xl">
        {finalCtaHeading}
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed text-ink-dark/70">
        {finalCtaSub}
      </p>
      <div class="mt-8 flex justify-center">
        <CtaButton label={ctaLabel} href={academyCheckoutUrl} />
      </div>
      <p class="mt-4 text-xs uppercase tracking-wide text-ink-dark/50">
        {finalCtaTrust}
      </p>
    </div>
  </section>

  <SiteFooter tagline={footerTagline} logoName={pageTitle} logoHref={false} />

  <StickyCta label={ctaLabel} note={stickyNote} href={academyCheckoutUrl} />

  <ThemeCustomizer />
</Base>
